# Book Data Sources (Server-Side Only)
# Generate a free personal token at https://hardcover.app/account/api
HARDCOVER_API_KEY=

# Optional: Google Books API key for higher rate limits (works without a key too)
GOOGLE_BOOKS_API_KEY=

# Multi-User Accounts, Magic Link Auth & Shared Friend Groups (Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Shared token for single-user / LAN Vellum bridge when not using Supabase accounts
# (When using Supabase, each signed-in user automatically gets a personal fbr_... token in Settings!)
FOLIO_BRIDGE_TOKEN=
